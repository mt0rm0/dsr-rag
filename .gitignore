# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environment (uv)
.venv/

# Environment variables
.env

# Data: keep sample_docs, the gold set and examples; ignore everything else added at runtime
data/*
!data/sample_docs/
!data/sample_docs/*
!data/gold_dataset.json
!data/examples/

# Runtime directories
exports/*
!exports/.gitkeep
log/*
!log/.gitkeep
vector_db/*
!vector_db/.gitkeep
# Created when the notebooks run from notebooks/
notebooks/vector_db/
notebooks/log/
# Gradio writes a tunnel certificate here when share=True is used
.gradio/

# IDE
.vscode/
.idea/

# Test / lint caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
